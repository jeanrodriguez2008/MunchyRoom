# ============================================================
# MunchyRoom · variables de entorno
# Copia este archivo como .env y completa los valores reales.
# En Render se configuran en Settings > Environment.
# ============================================================

# PostgreSQL de Neon Tech (obligatorio en producción).
# Debe incluir sslmode=require. Neon suele entregar channel_binding=require.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clave para firmar la cookie de sesión. Genera una cadena aleatoria larga:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# Zona horaria de la aplicación (Venezuela).
TZ=America/Caracas

# Entorno: development | production
ENV=development

# Cookies seguras (HTTPS). En local con http debe ser false; en Render true.
COOKIE_SECURE=false

# Credenciales del administrador inicial (solo se usan si la BD está vacía).
SEED_ADMIN_EMAIL=admin@munchy.com
SEED_ADMIN_PASSWORD=MunchyAdmin2026*
SEED_ADMIN_NAME=Administrador MunchyRoom

# Cuenta de soporte webmaster: oculta para los administradores.
# Se crea automáticamente solo si WEBMASTER_PASSWORD tiene un valor.
WEBMASTER_EMAIL=webmaster@munchy.com
WEBMASTER_NAME=Webmaster MunchyRoom
WEBMASTER_PASSWORD=

# Dominios corporativos permitidos en el autorregistro (separados por coma).
CORPORATE_EMAIL_DOMAINS=munchy.com

# Opcional: protección de fuerza bruta y duración de sesión (segundos).
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_WINDOW_SECONDS=900
REGISTRATION_MAX_ATTEMPTS=20
REGISTRATION_WINDOW_SECONDS=3600
SESSION_MAX_AGE=28800

# Opcional: debug detallado (no usar en producción).
DEBUG=false
